# Copy to .env.airflow and fill in, then: docker compose --env-file .env.airflow up
#
# On Linux set this to your host UID so files the containers write are owned by
# you rather than root. On macOS 50000 is fine.
AIRFLOW_UID=50000

# Same credentials as .env - the containers need them for scripts/ingest.py.
EIA_API_KEY=
NOAA_TOKEN=

# The web login is created by SimpleAuthManager on first boot; its generated
# password lands in simple_auth_manager_passwords.json.generated inside the
# scheduler container (see README).
